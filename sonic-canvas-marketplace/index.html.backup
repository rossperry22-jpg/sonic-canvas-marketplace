<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sonic Canvas Marketplace | Digital Persona Assets</title>
    <meta name="description" content="Discover and license 75 unique AI‑generated music personas. Each persona is a fully‑realized digital artist with style, backstory, and commercial potential.">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link rel="stylesheet" href="css/style.css">
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="assets/favicon.ico">
</head>
<body>
    <!-- Header -->
    <header>
        <div class="container">
            <div class="logo">Sonic Canvas</div>
            <div class="tagline">The world's first marketplace for AI‑generated music personas</div>
        </div>
    </header>

    <!-- Hero -->
    <section class="hero">
        <div class="container">
            <h1>Own the Future of Sound</h1>
            <p>
                Sonic Canvas presents 75 fully‑realized digital artists, each with a unique musical style, interactive brain, and visual identity. 
                License these personas for video games, film soundtracks, brand campaigns, or as your next virtual artist.
            </p>
            <a href="#marketplace" class="cta-button">Explore the Collection</a>
        </div>
    </section>

    <!-- Marketplace -->
    <main class="container" id="marketplace">
        <!-- Controls -->
        <div class="controls">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" id="search-input" placeholder="Search personas by name, description, use case...">
            </div>
            <div class="filter-buttons">
                <!-- Filters will be injected by JavaScript -->
            </div>
        </div>

        <!-- Stats -->
        <div class="stats">
            <div class="stat-item">
                <div class="stat-number" id="stat-total">75</div>
                <div class="stat-label">Total Personas</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="stat-images">18</div>
                <div class="stat-label">With Visual Art</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="stat-clusters">45</div>
                <div class="stat-label">Unique Clusters</div>
            </div>
            <div class="stat-item">
                <div class="stat-number" id="stat-delta">32</div>
                <div class="stat-label">Delta Personas</div>
            </div>
        </div>

        <!-- Persona Grid -->
        <div class="persona-grid" id="persona-grid">
            <!-- Cards will be injected by JavaScript -->
        </div>

        <!-- Call to Action -->
        <div style="text-align: center; margin: 4rem 0;">
            <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">Ready to License a Persona?</h2>
            <p style="color: var(--text-secondary); max-width: 700px; margin: 0 auto 2rem;">
                Each persona includes exclusive rights to the name, style prompt, lyrical blueprint, and interactive brain.
                We handle the audio generation via our Suno integration—you receive a turnkey digital artist.
            </p>
            <a href="mailto:licensing@soniccanvas.ai" class="cta-button">Contact Licensing Team</a>
        </div>
    </main>

    <!-- Modal -->
    <div class="modal-overlay" id="modal-overlay">
        <div class="modal" id="modal-content">
            <!-- Modal content will be injected by JavaScript -->
        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>Sonic Canvas Marketplace &copy; 2026 | A Vector Systems Production</p>
            <p style="margin-top: 0.5rem; font-size: 0.8rem;">
                All persona assets are AI‑generated and protected by proprietary IP frameworks. Licensing grants commercial usage rights.
            </p>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="js/script.js"></script>
</body>
</html>